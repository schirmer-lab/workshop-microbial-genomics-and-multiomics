# Multi-stage Dockerfile for optimized biodev container
# This reduces image size by ~30-40% through multi-stage builds and cleanup optimizations

# ================================
# BUILD STAGE - Contains build tools and temporary files
# ================================
FROM ubuntu:24.04 AS builder

# Get build platform information for architecture-specific handling
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Set environment variables to prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV MAMBA_ROOT_PREFIX=/opt/conda
ENV PATH=/opt/conda/bin:$PATH

# Store architecture info for runtime use
ENV TARGETARCH=${TARGETARCH}
ENV TARGETPLATFORM=${TARGETPLATFORM}

# Architecture detection for conditional package installation
RUN echo "Building for platform: ${TARGETPLATFORM:-linux/amd64}" && \
    echo "Target architecture: ${TARGETARCH:-amd64}" && \
    echo "Build platform: ${BUILDPLATFORM:-linux/amd64}"

# Install base system packages and build dependencies in single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        bzip2 \
        wget \
        build-essential \
        git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy and install system packages from packages.txt (build-time only packages)
COPY packages-build.txt /tmp/packages-build.txt
RUN set -eux; \
    sed -i 's/\r$//' /tmp/packages-build.txt || true; \
    if [ -s /tmp/packages-build.txt ]; then \
        apt-get update; \
        grep -vE '^\s*#|^\s*$' /tmp/packages-build.txt | xargs apt-get install -y --no-install-recommends; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
    fi; \
    rm -rf /tmp/packages-build.txt

# Configure Unicode support (works on both ARM64 and AMD64)
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen

# Install micromamba with architecture detection
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64|x86_64) MAMBA_ARCH="linux-64" ;; \
        arm64|aarch64) MAMBA_ARCH="linux-aarch64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac; \
    echo "Installing micromamba for architecture: $MAMBA_ARCH"; \
    curl -L "https://micro.mamba.pm/api/micromamba/$MAMBA_ARCH/latest" -o /tmp/micromamba.tar.bz2; \
    mkdir -p /usr/local/bin; \
    tar -xvj -C /usr/local/bin -f /tmp/micromamba.tar.bz2 bin/micromamba --strip-components=1; \
    rm /tmp/micromamba.tar.bz2

# Copy architecture-specific environment file
COPY environment-${TARGETARCH:-amd64}-optimized.yml /tmp/environment.yml

# Install conda packages and Jupyter kernels (before aggressive cleanup)
RUN echo "Installing conda packages for ${TARGETARCH:-amd64}..." && \
    /usr/local/bin/micromamba install -y -f /tmp/environment.yml || { \
        echo "Some packages failed to install, trying with --strict-channel-priority=false"; \
        /usr/local/bin/micromamba install -y -f /tmp/environment.yml --strict-channel-priority=false; \
    } && \
    echo "Installing Jupyter kernels..." && \
    /usr/local/bin/micromamba run python -m ipykernel install --sys-prefix --name python3 --display-name "Python 3.10" && \
    /usr/local/bin/micromamba run R -e "IRkernel::installspec(user = FALSE)" && \
    echo "Cleaning up conda environment..." && \
    /usr/local/bin/micromamba clean -a -y && \
    # Remove conda package cache and temporary files \
    rm -rf /opt/conda/pkgs/* && \
    # Remove Python cache files (but preserve essential modules) \
    find /opt/conda -name "*.pyc" -delete && \
    find /opt/conda -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    # Remove documentation and man pages \
    rm -rf /opt/conda/share/doc /opt/conda/share/man && \
    # Remove test directories (but preserve IPython.testing and other essential test modules) \
    find /opt/conda -path "*/site-packages/*/test*" -type d ! -path "*/IPython/*" ! -path "*/jupyter*" ! -path "*/ipykernel*" -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /tmp/environment.yml /root/.cache

# Download and install mmseqs2 (more efficient than conda package)
#RUN wget -O /tmp/mmseqs-linux-sse2.tar.gz https://mmseqs.com/latest/mmseqs-linux-sse2.tar.gz && \
#    mkdir -p /opt/mmseqs && \
#    tar -xvzf /tmp/mmseqs-linux-sse2.tar.gz -C /opt/mmseqs --strip-components=1 && \
#    rm /tmp/mmseqs-linux-sse2.tar.gz

# Copy and run comprehensive environment test (build-time validation)
COPY test_environment.sh /tmp/test_environment.sh
RUN chmod +x /tmp/test_environment.sh && \
    /tmp/test_environment.sh && \
    rm /tmp/test_environment.sh

# ================================
# RUNTIME STAGE - Minimal runtime environment
# ================================
FROM ubuntu:24.04 AS runtime

# Get build platform information for architecture-specific handling
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG BUILDPLATFORM

# Set environment variables to prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV MAMBA_ROOT_PREFIX=/opt/conda
#ENV PATH=/opt/conda/bin:/opt/mmseqs/bin:$PATH
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Store architecture info for runtime use
ENV TARGETARCH=${TARGETARCH}
ENV TARGETPLATFORM=${TARGETPLATFORM}

# Install only runtime system packages (no build tools)
COPY packages-runtime.txt /tmp/packages-runtime.txt
RUN set -eux; \
    apt-get update; \
    sed -i 's/\r$//' /tmp/packages-runtime.txt || true; \
    if [ -s /tmp/packages-runtime.txt ]; then \
        grep -vE '^\s*#|^\s*$' /tmp/packages-runtime.txt | xargs apt-get install -y --no-install-recommends; \
    fi; \
    # Configure Unicode support \
    sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen 2>/dev/null || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen && \
    # Cleanup in same layer \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/packages-runtime.txt

# Copy conda environment from builder
COPY --from=builder /opt/conda /opt/conda

# Copy micromamba binary
COPY --from=builder /usr/local/bin/micromamba /usr/local/bin/micromamba

# Copy mmseqs2 installation
#COPY --from=builder /opt/mmseqs /opt/mmseqs

# Create workspace directory
WORKDIR /workspace

# Verify installation with minimal test
RUN echo "Verifying runtime environment..." && \
    python --version && \
    R --version | head -1 && \
    echo "✅ Runtime environment verified"