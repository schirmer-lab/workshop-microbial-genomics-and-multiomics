{
  "name": "Course Pilot - R with Jupyter",
  
  // Option 1: Use published Docker image (default)
  "image": "schirmerlab/biodev:1.0",
  
  // Option 2: Build locally (uncomment the lines below and comment out the "image" line above)
  // "dockerFile": "../docker/Dockerfile",
  // "context": "../docker",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "reditorsupport.r",
        "REditorSupport.r-lsp"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "jupyter.kernels.trusted": [
          "/opt/conda/share/jupyter/kernels/ir"
        ]
      }
    }
  },
  
  // Post-create command to verify kernels
  "postCreateCommand": "bash -c 'source ~/micromamba/etc/profile.d/micromamba.sh && micromamba activate course-pilot && echo \"Available Jupyter kernels:\" && jupyter kernelspec list'"
}