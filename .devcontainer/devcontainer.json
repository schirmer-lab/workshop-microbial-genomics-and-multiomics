{
  "name": "Course Pilot - R with Jupyter",

  // Option 1: Use published Docker image (default)
  "image": "schirmerlab/biodev:1.1.1",

  // Option 2: Build locally (uncomment the lines below and comment out the "image" line above)
  // "dockerFile": "../docker/Dockerfile",
  // "context": "../docker",

  // Provide a command to keep container running
  "overrideCommand": true,

  // Create data directory on host before container starts
  "initializeCommand": "mkdir -p ${localEnv:HOME}/biodata",

  // Mount user's data directory with proper user mapping
  "mounts": [
    "type=bind,source=${localEnv:HOME}/biodata,target=/biodata,consistency=cached"
  ],

  // Handle cross-platform file permissions
  "remoteUser": "root",

  // Comprehensive permission setup and biodata download for seamless host-container file operations
  "postCreateCommand": "bash -c 'mkdir -p /biodata && chmod 777 /biodata && echo \"# File permission settings for cross-platform compatibility\" >> /root/.bashrc && echo \"umask 0000\" >> /root/.bashrc && echo \"export JUPYTER_ALLOW_INSECURE_WRITES=1\" >> /root/.bashrc && bash ${containerWorkspaceFolder}/docker/download_biodata.sh && find /biodata -type d -exec chmod 777 {} + 2>/dev/null || true && find /biodata -type f -exec chmod 666 {} + 2>/dev/null || true'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "reditorsupport.r",
        "REditorSupport.r-lsp"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.terminal.activateEnvironment": false,
        "r.rterm.linux": "/usr/bin/R",
        "r.rpath.linux": "/usr/bin/R",
        "r.lsp.enabled": true,
        "r.bracketedPaste": true,
        "jupyter.jupyterServerType": "local",
        "jupyter.kernels.trusted": [
          "/opt/conda/share/jupyter/kernels/ir"
        ],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}