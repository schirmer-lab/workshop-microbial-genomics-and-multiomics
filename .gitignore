#------------------------------------------------------------------------------
# OS-specific files
#------------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# macOS folder attributes
__MACOSX/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

#------------------------------------------------------------------------------
# Python
#------------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
develop-eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# PyInstaller
*.manifest
*.spec

# Virtual Environments
venv/
ENV/
env/
.venv/
.env/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb~  # temp save files

# Output of scripts/run_notebooks.sh: executed copies, logs, run summaries
.nbrun/

# Python profiling
.prof
*.pstats
*.lprof

# Test cache
.pytest_cache/
.tox/
coverage/
htmlcov/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs and Editors
.vscode/
.idea/
*.code-workspace

#------------------------------------------------------------------------------
# R
#------------------------------------------------------------------------------

.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj
.Rcheck/

# R package building
.Rbuildignore
*.tar.gz

# Renviron files
.Renviron

#------------------------------------------------------------------------------
# Jupyter / IPython
#------------------------------------------------------------------------------

.ipynb_checkpoints/
profile_default/
ipython_config.py

# VS Code Jupyter settings
.vscode-jupyter/

#------------------------------------------------------------------------------
# Containers / Dev Environments
#------------------------------------------------------------------------------

# Docker
**/.dockerignore
docker-compose*.yml
*.pid


#------------------------------------------------------------------------------
# Logs and temp files
#------------------------------------------------------------------------------

*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*.old

# Systemd or daemon metadata
*.pid
*.seed

#------------------------------------------------------------------------------
# Metabiome build artifacts
#------------------------------------------------------------------------------

# Generated by cythonize() in Metabiome/setup.py from the .pyx sources.
# The .pyx / .pxd / .pyi files are the sources and stay tracked.
Metabiome/src/metabiome/optimized/*.c
Metabiome/src/metabiome/optimized/*.html
Metabiome/src/metabiome/optimized/*.so
Metabiome/src/metabiome/optimized/*.dylib
Metabiome/src/metabiome/optimized/*.pyd

#------------------------------------------------------------------------------
# Node (if using JS tools in container)
#------------------------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

#------------------------------------------------------------------------------
# Others (Optional - uncomment if used)
#------------------------------------------------------------------------------

# .env files (comment out if you want them tracked)
# .env
# .env.*

# Secrets (be careful)
*.key
*.pem
*.crt

